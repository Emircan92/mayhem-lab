OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Item-only output budget (includes reasoning tokens). Integer 1201..32768; default 8192.
# One retry on token exhaustion/incomplete output doubles this budget, capped at 32768.
# Augment requests retain their existing 1200-token budget and do not use this retry.
# MAYHEM_ITEM_MAX_OUTPUT_TOKENS=8192

# Optional local-only UI/testing seam. Use "fake" without an API call; omit for OpenAI.
# MAYHEM_RECOMMENDATION_PROVIDER=fake
